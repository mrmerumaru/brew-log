# Copy this file to .env.local and fill in the two values from your Supabase
# project: Project Settings -> API.
#
#   VITE_SUPABASE_URL      = "Project URL",  looks like https://abcxyz.supabase.co
#   VITE_SUPABASE_ANON_KEY = the "anon public" / "Publishable" key
#
# The URL must be the BARE project URL — no trailing path. If you copy the
# "Data API endpoint" instead you'll get .../rest/v1/ on the end, and every
# request fails with "Invalid path specified in request URL". The client
# library appends /rest/v1 and /auth/v1 itself.
#
# .env.local is gitignored and must never be committed or shared.
# Vite only reads this file at startup — restart `npm run dev` after editing.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
